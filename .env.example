# Copy to .env and fill in the empty values. Never commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=equipment_rental
DB_USERNAME=rental
DB_PASSWORD=rental_dev

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=1h

# Optional. When both are set, this admin account is created at startup if it does not exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
